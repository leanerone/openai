# ==============================================
# Codex Internal API Proxy Configuration
# ==============================================

# ----- Upstream (the internal API Codex will proxy to) -----
# Must support OpenAI Chat Completions API
UPSTREAM_BASE_URL=https://your-internal-api.corp.local/v1
UPSTREAM_API_KEY=sk-your-internal-key
UPSTREAM_MODEL=internal-model-name

# Override only if your upstream uses non-standard paths
# UPSTREAM_CHAT_PATH=/chat/completions
# UPSTREAM_MODELS_PATH=/models

# ----- Local proxy server -----
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8000

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FILE=
REQUEST_LOG=
DEBUG_DUMP=false

# ----- Optional: extra upstream headers (semicolon-separated) -----
# EXTRA_HEADERS=X-Corp-User=alice;X-Trace-ID=foo

# ----- Optional: override auth header entirely -----
# AUTH_HEADER=Basic dXNlcjpwYXNzd29yZA==